# Copy to .env on the server and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Optional: your Telegram chat id. If empty, the first person to send /start to the bot becomes the owner.
TELEGRAM_OWNER_CHAT_ID=
# Seconds between his thoughts (180 = every 3 minutes).
TICK_SECONDS=180
# Which Claude model picks his moves.
LILGUY_MODEL=claude-haiku-5-5
# Set to 1 to run without AI (simple rules), e.g. for testing.
DRY_RUN=0
DATA_FILE=data/lilguy.json
# His live world page. The installer makes WORLD_TOKEN for you; leave it alone.
WORLD_URL=https://lilguy.gokkehub.com
WORLD_TOKEN=
# For the workshop's cost estimates: Danish kroner per US dollar.
USD_TO_DKK=6.9
